{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Bone", "color": "#F6F2EC" },
				{ "slug": "surface", "name": "White", "color": "#FFFFFF" },
				{ "slug": "sand", "name": "Sand", "color": "#ECE4D8" },
				{ "slug": "stone", "name": "Stone", "color": "#D8CDBE" },
				{ "slug": "ink", "name": "Ink", "color": "#1B1D1B" },
				{ "slug": "muted", "name": "Muted", "color": "#5B5E59" },
				{ "slug": "eucalypt", "name": "Eucalypt", "color": "#23382E" },
				{ "slug": "eucalypt-light", "name": "Eucalypt light", "color": "#DCE5DE" },
				{ "slug": "clay", "name": "Clay", "color": "#A4552D" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Instrument Serif",
					"fontFamily": "\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Instrument Serif", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-serif-regular.woff" ] },
						{ "fontFamily": "Instrument Serif", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-serif-italic.woff" ] }
					]
				},
				{
					"slug": "body",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-variable.woff" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "S", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "M", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "L", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.75rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "4.25rem" } },
				{ "slug": "display", "name": "Display", "size": "5rem", "fluid": { "min": "2.9rem", "max": "6.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "0.5rem" },
				{ "slug": "30", "name": "XS", "size": "1rem" },
				{ "slug": "40", "name": "S", "size": "1.5rem" },
				{ "slug": "50", "name": "M", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "L", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "XL", "size": "clamp(3.5rem, 8vw, 6.5rem)" }
			]
		},
		"custom": {
			"radius": { "card": "18px", "pill": "999px" }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700", "lineHeight": "1.3", "letterSpacing": "0" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--eucalypt)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--clay)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--clay)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "letterSpacing": "0.01em" },
				":hover": { "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--surface)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--ink)", "offset": "3px", "style": "solid", "width": "2px" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.9rem", "lineHeight": "1" },
				"elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--ink)" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "booking-band", "title": "Booking band", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-service", "title": "Service page", "postTypes": [ "page" ] },
		{ "name": "page-condition", "title": "Condition page", "postTypes": [ "page" ] },
		{ "name": "page-full", "title": "Full width (no title)", "postTypes": [ "page" ] }
	]
}
